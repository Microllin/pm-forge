{
  "name": "@pmforge/chat",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "独立对话服务：pi 集成 + pi 版本升级 + web 对话",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:server": "tsx server/supervisor.ts --watch",
    "dev:web": "vite",
    "start": "concurrently -k -n server,web -c blue,green \"pnpm start:server\" \"pnpm start:web\"",
    "start:server": "tsx server/supervisor.ts",
    "start:web": "vite preview",
    "build": "vite build",
    "typecheck": "tsc --noEmit --pretty false"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.141",
    "@assistant-ui/react": "0.15.28",
    "@assistant-ui/react-ai-sdk": "1.4.17",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/lang-xml": "6.1.0",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@fontsource-variable/noto-sans-sc": "5.3.1",
    "@tanstack/react-query": "5.101.4",
    "@xyflow/react": "12.8.6",
    "ai": "7.0.138",
    "better-sqlite3": "13.0.3",
    "codemirror": "6.0.2",
    "fastify": "5.11.2",
    "fflate": "0.8.2",
    "lucide-react": "0.577.0",
    "playwright-core": "1.55.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "vite": "8.2.1"
  }
}
